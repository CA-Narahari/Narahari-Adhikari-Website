# Public client configuration. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only configuration. Keep these out of browser bundles and version control.
SUPABASE_SERVICE_ROLE_KEY=server_only_value
SUPABASE_JWT_SECRET=server_only_value

# Optional server integrations
RESEND_API_KEY=server_only_value
